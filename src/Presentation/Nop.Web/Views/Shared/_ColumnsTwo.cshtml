@{
    Layout = "_Root";
}
@{
    //current category ID
    var currentCategoryId = 0;
    if (Url.ActionContext.RouteData.Values["controller"].ToString().Equals("catalog", StringComparison.InvariantCultureIgnoreCase) &&
        Url.ActionContext.RouteData.Values["action"].ToString().Equals("category", StringComparison.InvariantCultureIgnoreCase))
    {
        currentCategoryId = Convert.ToInt32(Url.ActionContext.RouteData.Values["categoryId"].ToString());
    }

    //current manufacturer ID
    var currentManufacturerId = 0;
    if (Url.ActionContext.RouteData.Values["controller"].ToString().Equals("catalog", StringComparison.InvariantCultureIgnoreCase) &&
        Url.ActionContext.RouteData.Values["action"].ToString().Equals("manufacturer", StringComparison.InvariantCultureIgnoreCase))
    {
        currentManufacturerId = Convert.ToInt32(Url.ActionContext.RouteData.Values["manufacturerId"].ToString());
    }

    //current product ID
    var currentProductId = 0;
    if (Url.ActionContext.RouteData.Values["controller"].ToString().Equals("product", StringComparison.InvariantCultureIgnoreCase) &&
        Url.ActionContext.RouteData.Values["action"].ToString().Equals("productdetails", StringComparison.InvariantCultureIgnoreCase))
    {
        currentProductId = Convert.ToInt32(Url.ActionContext.RouteData.Values["productId"].ToString());
    }
}

@await RenderSectionAsync("Breadcrumb", false)

<!-- FILTER BUTTON -->

<div class="page category-page-layout">

    <!-- FLOATING FILTER BUTTON -->
    <div class="mobile-filter-toggle">
        <button type="button" class="filter-toggle-btn" aria-controls="left-side-filter" aria-expanded="false">
            <span class="filter-icon">☰</span>
            <span>Filter</span>
        </button>
    </div>

    <!-- SIDEBAR -->
    <div class="side-2 closed" id="left-side-filter">

        <!-- FILTER HEADER -->
        <div class="filter-header">
            <div></div>
            <!-- desktop + mobile close -->
            <button type="button" class="filter-close" aria-label="Close filter">
                <i class="fa fa-times">x</i>
            </button>
        </div>

       

        <!-- FILTER CONTENT -->
        @if (IsSectionDefined("left"))
        {
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.LeftSideColumnBefore })

            @await RenderSectionAsync("left")

            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.LeftSideColumnAfter })
        }
        else
        {
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.LeftSideColumnBefore })

            @await RenderSectionAsync("CatalogFilters", false)

            @await Component.InvokeAsync(typeof(CategoryNavigationViewComponent), new
            {
                currentCategoryId = currentCategoryId,
                currentProductId = currentProductId
            })

            @await Component.InvokeAsync(typeof(WidgetViewComponent), new
            {
                widgetZone = PublicWidgetZones.LeftSideColumnAfterCategoryNavigation
            })

            @await Component.InvokeAsync(typeof(ManufacturerNavigationViewComponent), new
            {
                currentManufacturerId = currentManufacturerId
            })

            @await Component.InvokeAsync(typeof(VendorNavigationViewComponent))

            @await Component.InvokeAsync(typeof(RecentlyViewedProductsBlockViewComponent), new
            {
                productThumbPictureSize = 64
            })

            @await Component.InvokeAsync(typeof(PopularProductTagsViewComponent))

            @await Component.InvokeAsync(typeof(PollBlockViewComponent), new
            {
                systemKeyword = "LeftColumnPoll"
            })

            @await Component.InvokeAsync(typeof(WidgetViewComponent), new
            {
                widgetZone = PublicWidgetZones.LeftSideColumnAfter
            })
        }


    </div>

    <!-- MAIN CONTENT -->
    <div class="center-2">
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new
        {
            widgetZone = PublicWidgetZones.MainColumnBefore
        })

        @RenderBody()

        @await Component.InvokeAsync(typeof(WidgetViewComponent), new
        {
            widgetZone = PublicWidgetZones.MainColumnAfter
        })

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const sidebar = document.querySelector(".side-2");
        const toggleBtn = document.querySelector(".filter-toggle-btn");
        const closeBtn = document.querySelector(".filter-close");
        const filterWrapper = document.querySelector(".mobile-filter-toggle");
        const categorySection = document.querySelector(".category-page-layout");

        if (!sidebar || !toggleBtn || !closeBtn || !filterWrapper || !categorySection) {
            return;
        }

        function isMobileFilter() {
            return window.innerWidth <= 1000;
        }

        function setExpanded(isExpanded) {
            toggleBtn.setAttribute("aria-expanded", isExpanded ? "true" : "false");
        }

        function bringFilterIntoView() {
            sidebar.scrollTop = 0;

            if (isMobileFilter()) {
                closeBtn.focus({ preventScroll: true });
                return;
            }

            sidebar.scrollIntoView({
                behavior: "smooth",
                block: "start"
            });
        }

        function openFilter() {
            sidebar.classList.remove("closed");
            sidebar.classList.add("active");
            filterWrapper.classList.add("filter-open");
            setExpanded(true);
            window.setTimeout(bringFilterIntoView, 80);
        }

        function closeFilter() {
            sidebar.classList.remove("active");
            sidebar.classList.add("closed");
            filterWrapper.classList.remove("filter-open");
            setExpanded(false);
        }

        closeFilter();

        toggleBtn.addEventListener("click", function () {
            if (sidebar.classList.contains("closed")) {
                openFilter();
            } else {
                closeFilter();
            }
        });

        closeBtn.addEventListener("click", closeFilter);

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape" && !sidebar.classList.contains("closed")) {
                closeFilter();
                toggleBtn.focus({ preventScroll: true });
            }
        });

        function handleFilterButtonVisibility() {
            const rect = categorySection.getBoundingClientRect();
            const isVisible = rect.top < window.innerHeight && rect.bottom > 150;

            filterWrapper.classList.toggle("visible", isVisible);
        }

        handleFilterButtonVisibility();

        window.addEventListener("scroll", handleFilterButtonVisibility, { passive: true });
        window.addEventListener("resize", function () {
            closeFilter();
            handleFilterButtonVisibility();
        });
    });
</script>